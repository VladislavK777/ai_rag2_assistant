FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
RUN pip install --no-cache-dir \
    "fastapi>=0.115" "uvicorn[standard]>=0.30" "pydantic>=2.9" \
    "sentence-transformers>=3.2" "torch>=2.4" --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple

COPY app/services/embedding_cpu_server.py ./app/services/

EXPOSE 80
CMD ["uvicorn", "app.services.embedding_cpu_server:app", "--host", "0.0.0.0", "--port", "80"]
