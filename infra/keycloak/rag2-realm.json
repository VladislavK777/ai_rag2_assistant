{
  "realm": "rag2",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Администратор системы RAG2"
      },
      {
        "name": "EMPLOYEE",
        "description": "Сотрудник"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rag2_client",
      "name": "RAG2 Assistant",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "",
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:5173/*",
        "https://localhost/*",
        "https://rag2.company.local/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:5173",
        "https://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost/*##http://localhost/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "employee_no",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "employee_no",
            "claim.name": "employee_no",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "full_name",
            "claim.name": "full_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "dept_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "dept_code",
            "claim.name": "dept_code",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "role (multi-valued)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
