# RAG2 MVP — конфигурация окружения
# Скопировать в .env и заполнить секреты. Файл .env не коммитится (gitignore).

# ===== Общее =====
COMPOSE_PROJECT_NAME=rag2
TZ=Europe/Moscow

# ===== PostgreSQL =====
POSTGRES_USER=rag2
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rag2

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_REDIS

# ===== Backend =====
JWT_SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@company.ru
ADMIN_PASSWORD=CHANGE_ME_ADMIN
CORS_ORIGINS=http://localhost:5173

# ===== MinIO =====
MINIO_ROOT_USER=rag2minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
MINIO_BUCKETS=documents,audio

# ===== Qdrant =====
QDRANT_API_KEY=CHANGE_ME_QDRANT

# ===== Vault (dev-mode) =====
VAULT_DEV_ROOT_TOKEN_ID=CHANGE_ME_VAULT_ROOT
VAULT_ADDR=http://vault:8200

# ===== LLM-провайдер =====
# local  — локальный vLLM (целевая on-prem схема, по умолчанию)
# yandex — внешний Yandex GPT (лёгкий режим без GPU для LLM;
#          запросы уходят наружу по HTTPS — учитывайте политику ИБ)
LLM_PROVIDER=local

# Локальный vLLM
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.60
VLLM_MAX_NUM_SEQS=12

# Yandex GPT (заполняется ТОЛЬКО при LLM_PROVIDER=yandex)
# API-ключ — секрет: не коммитить, не логировать. В целевом режиме — Vault KV.
# Получение: Yandex Cloud Console → AI Studio → API-ключи.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
# Embedding/STT/Guardrails остаются локальными при любом провайдере
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
STT_MODEL=nvidia/stt_ru_conformer_ctc_large
GUARD_MODEL=meta-llama/Llama-Guard-3-8B

# ===== Observability =====
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=rag2-backend
OTEL_TRACES_SAMPLER_ARG=1.0
